@page

@model IndexModel

@{
    ViewData["Title"] = "";
}

<!-- Header -->

<header id="inicio" class="site-header">

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <!-- Logo -->

            <a href="#inicio"
               class="logo-link"
               aria-label="Voltar ao início">

                <div class="logo-wrapper">

                    <img src="~/images/favicon.png"
                         alt="Bryan Albuquerque"
                         class="logo-img" />

                </div>

                <div class="logo-name">

                    <strong>Bryan</strong>

                    <span>Albuquerque</span>

                </div>

            </a>

            <!-- Menu mobile -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Abrir menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Menu -->

            <div class="collapse navbar-collapse"
                 id="menuPrincipal">

                <ul class="navbar-nav ms-auto menu-principal">

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#inicio">
                            Início
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#sobre">
                            Sobre
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#skills">
                            Habilidades
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#projetos">
                            Projetos
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#contato">
                            Contato
                        </a>

                    </li>

                </ul>

                <!-- Controle de tema -->

                <div class="theme-controls"
                     aria-label="Controle de tema">

                    <button type="button"
                            class="theme-button"
                            data-theme="dark"
                            aria-label="Usar tema original">

                        <i class="fa-solid fa-moon"></i>

                        <span>Original</span>

                    </button>

                    <button type="button"
                            class="theme-button"
                            data-theme="light"
                            aria-label="Usar tema claro">

                        <i class="fa-solid fa-sun"></i>

                        <span>Claro</span>

                    </button>

                </div>

            </div>

        </div>

    </nav>

</header>

<!-- Hero -->

<section class="hero-section">

    <div class="hero-particles">

        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>

    </div>

    <div class="container">

        <div class="hero-content">

            <!-- Texto -->

            <div class="hero-text">

                <div class="hero-label">
                    DESENVOLVEDOR .NET
                </div>

                <h1>

                    Transformando

                    <span class="gradient-text">
                        ideias
                    </span>

                    em

                    <span class="outline-text">
                        soluções.
                    </span>

                </h1>

                <p class="hero-description">

                    Olá, eu sou

                    <strong>
                        Bryan Albuquerque.
                    </strong>

                    Desenvolvedor focado na criação de aplicações web,
                    sistemas desktop, APIs e soluções sob medida
                    utilizando o ecossistema

                    <strong>
                        .NET.
                    </strong>

                </p>

                <!-- Tecnologias -->

                <div class="hero-technologies">

                    <span>

                        <i class="fa-solid fa-code"></i>

                        C#

                    </span>

                    <span>

                        <i class="fa-solid fa-globe"></i>

                        ASP.NET Core

                    </span>

                    <span>

                        <i class="fa-solid fa-database"></i>

                        SQL Server

                    </span>

                    <span>

                        <i class="fa-solid fa-bolt"></i>

                        REST API

                    </span>

                </div>

                <!-- Redes sociais -->

                <div class="hero-social">

                    <span>
                        Encontre-me
                    </span>

                    <a href="https://github.com/BryanAlbuquerque"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="GitHub">

                        <i class="fa-brands fa-github"></i>

                    </a>

                    <a href="mailto:bryanalburquerque2@gmail.com"
                       aria-label="E-mail">

                        <i class="fa-solid fa-envelope"></i>

                    </a>

                    <a href="https://wa.me/5511974217641"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="WhatsApp">

                        <i class="fa-brands fa-whatsapp"></i>

                    </a>

                </div>

            </div>

            <!-- Foto -->

            <div class="hero-visual">

                <div class="hero-image-decoration decoration-one"></div>

                <div class="hero-image-decoration decoration-two"></div>

                <div class="hero-photo-container">

                    <div class="hero-photo-glow"></div>

                    <img src="~/images/perfil-dark.png"
                         data-dark-src="@Url.Content("~/images/perfil-dark.png")"
                         data-light-src="@Url.Content("~/images/perfil-light.png")"
                         alt="Bryan Albuquerque"
                         class="foto-perfil theme-photo" />

                </div>

                <!-- Card -->

                <div class="floating-card floating-card-one">

                    <div class="floating-icon">

                        <i class="fa-solid fa-code"></i>

                    </div>

                    <div>

                        <strong>
                            Clean Code
                        </strong>

                        <span>
                            Código organizado
                        </span>

                    </div>

                </div>

                <div class="floating-card floating-card-two">

                    <div class="floating-icon">

                        <i class="fa-solid fa-layer-group"></i>

                    </div>

                    <div>

                        <strong>
                            .NET Developer
                        </strong>

                        <span>
                            Backend & Web
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Scroll -->

    <a href="#sobre"
       class="scroll-indicator">

