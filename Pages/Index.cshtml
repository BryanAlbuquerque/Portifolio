@page
@model IndexModel

@{
    ViewData["Title"] = "Bryan Albuquerque";
}

<!-- HEADER / NAVEGAÇÃO -->
<header id="inicio" class="site-header">

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            <!-- LOGO -->
            <a href="#inicio" class="logo-link" aria-label="Voltar ao início">
                <img src="~/images/favicon.png"
                     alt="Logo Bryan Albuquerque"
                     class="logo-img" />
            </a>

            <!-- MENU MOBILE -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Abrir menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="menuPrincipal">

                <ul class="navbar-nav ms-auto menu-principal">

                    <li class="nav-item">
                        <a class="nav-link" href="#inicio">
                            Início
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#sobre">
                            Sobre
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#projetos">
                            Projetos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#skills">
                            Habilidades
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contato">
                            Contato
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- HERO -->
    <div class="hero-section">

        <div class="container">

            <div class="hero-content">

                <div class="hero-text">

                    <span class="hero-label">
                        DESENVOLVEDOR .NET
                    </span>

                    <h1>
                        Bryan Albuquerque
                    </h1>

                    <p class="hero-description">
                        Desenvolvedor focado na criação de aplicações web,
                        sistemas desktop e soluções sob medida utilizando
                        tecnologias do ecossistema .NET.
                    </p>

                    <div class="hero-technologies">

                        <span>C#</span>
                        <span>ASP.NET Core</span>
                        <span>SQL Server</span>
                        <span>REST API</span>

                    </div>

                    <div class="hero-actions">

                        <a href="#projetos" class="btn-primary-custom">
                            Ver projetos
                        </a>

                        <a href="~/Files/currBryan.pdf"
                           download
                           class="btn-secondary-custom">
                            Baixar currículo
                        </a>

                    </div>

                </div>


                <!-- FOTO -->
                <div class="hero-image">

                    <div class="hero-image-wrapper">

                        <img src="~/images/Bryan.png"
                             alt="Bryan Albuquerque - Desenvolvedor .NET"
                             class="foto-perfil" />

                    </div>

                </div>

            </div>

        </div>

    </div>

</header>


<!-- SOBRE -->
<section id="sobre" class="section section-about">

    <div class="container">

        <div class="section-header">

            <span class="section-label">
                SOBRE MIM
            </span>

            <h2 class="titulo-secao">
                Desenvolvimento com foco em soluções reais
            </h2>

        </div>


        <div class="about-content">

            <div class="about-image">

                <img src="~/images/Bryan.png"
                     alt="Bryan Albuquerque"
                     class="about-profile-image" />

            </div>


            <div class="about-text">

                <p>
                    Sou formado em Análise e Desenvolvimento de Sistemas
                    pela Universidade Paulista (UNIP), com foco no
                    desenvolvimento de aplicações utilizando C# e o
                    ecossistema .NET.
                </p>

                <p>
                    Tenho experiência prática no desenvolvimento de
                    sistemas desktop e aplicações web, trabalhando desde
                    a definição da estrutura da aplicação e implementação
                    da lógica de negócio até integração com banco de dados e
                    APIs.
                </p>

                <p>
                    Busco desenvolver soluções com código organizado,
                    arquitetura consistente, boa experiência de uso e
                    facilidade de manutenção.
                </p>


                <div class="about-services">

                    <h3>
                        O que posso desenvolver
                    </h3>

                    <ul>

                        <li>
                            Sistemas desktop personalizados
                        </li>

                        <li>
                            Aplicações web e sistemas administrativos
                        </li>

                        <li>
                            APIs e integrações entre sistemas
                        </li>

                        <li>
                            Sites institucionais e soluções sob demanda
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- HABILIDADES -->
<section id="skills" class="section skills-section">

    <div class="container">

        <div class="section-header">

            <span class="section-label">
                TECNOLOGIAS
            </span>

            <h2 class="titulo-secao">
                Habilidades
            </h2>

            <p class="section-description">
                Tecnologias utilizadas no desenvolvimento dos meus projetos.
            </p>

        </div>


        <div class="skills-grid">


            <!-- C# -->
            <div class="skill-card">

                <div class="skill-icon">
                    <img src="~/images/csharp.png"
                         alt="C#" />
                </div>

                <div class="skill-info">

                    <h3>C#</h3>

                    <p>
                        Desenvolvimento de aplicações e lógica de negócio.
                    </p>

                </div>

            </div>


            <!-- SQL SERVER -->
            <div class="skill-card">

                <div class="skill-icon">
                    <img src="~/images/sql.png"
                         alt="SQL Server" />
                </div>

                <div class="skill-info">

                    <h3>SQL Server</h3>

                    <p>
                        Modelagem, consultas e gerenciamento de dados.
                    </p>

                </div>

            </div>


            <!-- MYSQL -->
            <div class="skill-card">

                <div class="skill-icon">

                    <img src="~/images/mySql.png"
                         alt="MySQL" />

                </div>

                <div class="skill-info">

                    <h3>MySQL</h3>

                    <p>
                        Desenvolvimento e gerenciamento de bancos relacionais.
                    </p>

                </div>

            </div>


            <!-- ASP.NET -->
            <div class="skill-card">

                <div class="skill-icon">

                    <img src="~/images/asp.net.png"
                         alt="ASP.NET" />

                </div>

                <div class="skill-info">

                    <h3>ASP.NET Core</h3>

                    <p>
                        Desenvolvimento de aplicações web com .NET.
                    </p>

                </div>

            </div>


            <!-- WEB API -->
            <div class="skill-card">

                <div class="skill-icon">

                    <img src="~/images/api.png"
                         alt="Web API" />

                </div>

                <div class="skill-info">

                    <h3>REST API</h3>

                    <p>
                        APIs para integração entre aplicações e serviços.
                    </p>

                </div>

            </div>


            <!-- HTML -->
            <div class="skill-card">

                <div class="skill-icon">

                    <img src="~/images/html.png"
                         alt="HTML" />

                </div>

                <div class="skill-info">

                    <h3>HTML</h3>

                    <p>
                        Estruturação de interfaces e aplicações web.
                    </p>

                </div>

            </div>


            <!-- CSS -->
            <div class="skill-card">

                <div class="skill-icon">

                    <img src="~/images/css.png"
                         alt="CSS" />

                </div>

                <div class="skill-info">

                    <h3>CSS</h3>

                    <p>
                        Desenvolvimento visual e responsivo de interfaces.
                    </p>

                </div>

            </div>


        </div>

    </div>

</section>


